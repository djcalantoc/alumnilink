# Supabase (Project Settings → API)
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Legacy JWT anon key (eyJ…) or new publishable key (sb_publishable_…):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional: if you only use the new dashboard key name, set this instead of ANON_KEY:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Site URL for email confirmation & password recovery (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
